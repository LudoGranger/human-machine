# Copy to ~/.human-machine/.env (created by `bun run hm init`, mode 600).
# NEVER commit real values. All keys are optional; see README "What is free".

# --- Analysis model (pick one; without it, material is collected but not analyzed)
# ANTHROPIC_API_KEY=            # paid Anthropic API (default model claude-opus-5)
# HM_LLM_MODEL=claude-opus-5
# HM_LLM_PROVIDER=claude-cli    # use the locally installed Claude Code CLI (your Claude plan)
# HM_CLAUDE_CLI_MODEL=opus
HM_LLM_DAILY_BUDGET_USD=2

# --- Sources
# X_BEARER_TOKEN=               # X API v2 (paid). Enables X polling; HM_X_STREAM=1 enables the filtered stream
# HM_X_STREAM=0
# GITHUB_TOKEN=                 # optional
# GOOGLE_BOOKS_API_KEY=         # optional

# --- Hosted GBrain workspace for the PUBLIC evidence layer and agent collaboration (optional)
# GBRAIN_REMOTE_URL=
# GBRAIN_REMOTE_TOKEN=
# HM_GBRAIN_PUBLIC_BACKEND=remote   # or "local" to keep public evidence local even when remote is set

# --- Server
HM_HOST=127.0.0.1
HM_PORT=4747
# HM_UI_TOKEN=                  # required if HM_HOST is not loopback (server deployment)
# HM_CORS_ORIGINS=http://localhost:5173,https://ludogranger.github.io   # frontend origins allowed to call the API
# HM_DATA_DIR=~/.human-machine
